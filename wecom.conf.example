# 企业微信「应用」推送配置（QYWX_AM）
#
# 使用方法：
#   1. 复制本文件为 wecom.conf：  cp wecom.conf.example wecom.conf
#   2. 把下面的值换成你自己的真实凭据
#   3. wecom.conf 已被 .gitignore 忽略，不会随仓库提交，避免泄露
#
# 格式：corpid,corpsecret,touser,agentid
#   corpid    : 企业 ID（我的企业 -> 企业信息 -> 企业 ID）
#   corpsecret: 自建应用的 Secret（企业微信后台 -> 应用管理 -> 自建应用）
#   touser    : 接收人 userid；@all 表示应用可见范围内所有人
#   agentid   : 自建应用的 AgentId
#
# 注意：末尾若附带第 5 个字段（某些脚本格式的额外 token），本脚本会自动忽略，
#       不影响官方应用消息接口推送。

QYWX_AM=your_corpid,your_corpsecret,your_touser,your_agentid
